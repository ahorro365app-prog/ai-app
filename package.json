{
  "name": "ai-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:direct": "next build",
    "build:android": "npm run build && node scripts/copy-static-for-capacitor.js && npx cap sync android",
    "build:apk": "npm run build:android && node scripts/build-apk.js",
    "build:apk:release": "npm run build:android && cd android && gradlew assembleRelease",
    "clean": "rm -rf .next .next-dev out android/app/src/main/assets/public",
    "clean:android": "rm -rf android/app/src/main/assets/public",
    "sync:android": "node scripts/copy-static-for-capacitor.js && npx cap sync android",
    "start": "next start",
    "lint": "eslint",
    "generate:icons": "npx @capacitor/assets generate",
    "generate:icons:android": "npx @capacitor/assets generate android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/screen-orientation": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3",
    "@clerk/nextjs": "^6.33.3",
    "@prisma/client": "^6.17.0",
    "@sentry/nextjs": "^8.45.0",
    "@stripe/stripe-js": "^8.0.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.75.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "firebase": "^12.5.0",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.4",
    "openai": "^6.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-qr-code": "^2.0.18",
    "stripe": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.17.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
