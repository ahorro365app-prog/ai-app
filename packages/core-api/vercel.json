{
  "framework": "nextjs",
  "buildCommand": "cd packages/core-api && npm install && npm run build",
  "devCommand": "cd packages/core-api && npm run dev",
  "installCommand": "",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/confirm-expired",
      "schedule": "0 2 * * *"
    }
  ]
}

